CONFIG_OPLUS_FEATURE=y
CONFIG_OPLUS_CHG=y
CONFIG_OPLUS_SYSTEM=y

# sched/oplus: enable SCHED_ASSIST baseline (P0 — no UX_PRIORITY/SPREAD/FRAME_BOOST/UXIO/LOCKING yet)
CONFIG_OPLUS_FEATURE_SCHED_ASSIST=y

# GCC - Global Clock Controller
CONFIG_SM_GCC_8250=y

# CAMCC - Camera Clock Controller
CONFIG_SM_CAMCC_8250=y

# DISPCC - Display Clock Controller
CONFIG_SM_DISPCC_8250=y

# GPUCC - GPU Clock Controller
CONFIG_SM_GPUCC_8250=y

# VIDEOCC - Video Clock Controller
CONFIG_SM_VIDEOCC_8250=y

# NPUCC - NPU Clock Controller
CONFIG_SM_NPUCC_8250=y

# Interconnect
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y

# RPMH
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y

# AOSS
CONFIG_QCOM_AOSS_QMP=y

# RPMH Clock — provides clocks to downstream consumers via RPMh
CONFIG_QCOM_CLK_RPMH=y

# IOMMU / SMMU — REQUIRED for DMA peripherals on SM8250
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_IOMMU_UTIL=y

# Mailbox / IPCC — inter-processor communication
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y

# PDC — wake-up capable interrupt controller
CONFIG_QCOM_PDC=y

# GLINK / QMI — Qualcomm IPC protocol (apps↔modem/ADSP)
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_QMI_HELPERS=y

# CPUFreq
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# GPU — KGSL (downstream Adreno driver, owns GPU hardware per kona-gpu.dtsi)
# NVMEM is parent for QCOM_QFPROM; QCOM_QFPROM is parent for QCOM_KGSL.
# SYNC_FILE selects DMA_SHARED_BUFFER (needed for kgsl fence/dmabuf paths).
# DRM_MSM is NOT enabled: DTS disables upstream &gpu/&gmu to avoid conflict.
CONFIG_NVMEM=y
CONFIG_QCOM_QFPROM=y
CONFIG_QCOM_KGSL=y
CONFIG_SYNC_FILE=y
CONFIG_DMA_SHARED_BUFFER=y

# PHY — QMP for UFS/PCIe/USB (must be built-in, no modules available)
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_UFS=y

# Power reset
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT=y
CONFIG_POWER_RESET_QCOM_REBOOT_REASON=y

# Essential features
CONFIG_QCOM_CPR=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y

# UFS — full dependency chain (kbuild silently drops leaf configs
# whose depends-on parents are not also explicitly set)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_CRYPTO_QTI=y

# FBE (File-Based Encryption) — ColorOS /data is F2FS+FBE
# CONFIG_MD is the parent menuconfig for BLK_DEV_DM; without it,
# kbuild silently drops BLK_DEV_DM, DM_CRYPT, DM_VERITY, etc.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_DM_BOW=y

# Android first-stage mount crypto: FBE, metadata encryption, and verity.
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_QTI_CRYPTO_COMMON=y
CONFIG_QTI_CRYPTO_TZ=y

# USB
# CONFIG_USB is for host mode — not set to keep size minimal
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_MSM=y
CONFIG_MSM_HSUSB_PHY=y
CONFIG_USB_MSM_SSPHY_QMP=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y

# TypeC — required by qpnp-smb5.c (typec_register_port) and smb5-lib.c
CONFIG_TYPEC=y
CONFIG_USB_ROLE_SWITCH=y

# PMIC
# CONFIG_SPMI is the parent menuconfig for MFD_SPMI_PMIC; without it,
# kbuild silently drops MFD_SPMI_PMIC, QPNP_SMB5, RTC_DRV_PM8XXX, etc.
CONFIG_SPMI=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y

# Pinctrl
CONFIG_PINCTRL_SM8250=y

# Thermal
CONFIG_QCOM_TSENS=y
CONFIG_CPU_THERMAL=y

# Debug / power
CONFIG_DEBUG_FS=y

# Framebuffer console — show boot logs on screen
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

# ──────────────────────────────────────────
# OPLUS ported subsystems (Phase 1A-3)
# ──────────────────────────────────────────

# soc/oplus: project/device/boot identification
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y
CONFIG_OPLUS_PROJECT_INFO=y
CONFIG_OPLUS_DEVICE_INFO=y
CONFIG_OPLUS_BOOT_MODE=y

# power/oplus: charging core stubs
CONFIG_OPLUS_CHG_CORE=y

# power/oplus: active I2C gauge on both OnePlus SM8250 boards
CONFIG_OPLUS_GAUGE_IC_BQ27541=y
# CONFIG_OPLUS_CHARGER_IC_MP2650 is not set
# CONFIG_OPLUS_CHARGER_IC_DA9313 is not set

# power/oplus: minimal wired charging state machine
CONFIG_OPLUS_CHARGER=y

# power/supply: dependency closure for QCOM SMB5 and BQ27541 gauge
CONFIG_QCOM_POWER_SUPPLY=y
CONFIG_I2C=y

# power/supply/qcom: SMB5 charger driver (required by Kona adapter)
CONFIG_QPNP_SMB5=y

# power/supply/qcom: OPLUS Kona SMB5 adapter (smb5_chg_ops → oplus_chg_operations)
CONFIG_OPLUS_CHARGER_IC_KONA=y

# rtc: PMIC RTC — SMB5 hard-requires alarmtimer_get_rtcdev() != NULL
# (qpnp-smb5.c:3065-3069 returns -EPROBE_DEFER if RTC absent)
# CONFIG_RTC_CLASS is the parent menuconfig for RTC_DRV_PM8XXX.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y

# sched/locking: DISABLED — requires struct mutex/task_struct modifications
# (ux_dep_task, ux_depth, ux_state) that violate GKI KMI. Re-enable after
# vendor_hook-based redesign.
# CONFIG_OPLUS_LOCKING_STRATEGY is not set

# QCOM SMEM dependency (for oplus_project/device_info SMEM access)
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y

# CRITICAL: Force QCOM_SCM=y — this is a dependency gate.
# PINCTRL_SM8250, ARM_SMMU, QCOM_PDC (and 20+ others) use the kbuild
# tautology pattern "depends on QCOM_SCM || !QCOM_SCM". In kbuild
# tristate logic: !m=n, m||n=m — so when QCOM_SCM=m the pattern caps
# all these symbols to =m, EVEN if defconfig says =y.
# Built-in pinctrl/UFS/SMMU are REQUIRED for boot (no vendor modules
# for 5.10 on ColorOS 4.19 vendor_boot).
CONFIG_QCOM_SCM=y

# QCOM_COMMAND_DB has same kbuild tautology pattern:
# "depends on QCOM_COMMAND_DB || !QCOM_COMMAND_DB"
CONFIG_QCOM_COMMAND_DB=y

# IIO framework (for oplus device_info IIO channel reads)
CONFIG_IIO=y

# KGSL: GPU stability fix (kevent panic prevention)
CONFIG_OPLUS_BUG_STABILITY=y

