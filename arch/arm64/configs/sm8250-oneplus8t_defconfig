CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# EXT4 — /vendor, /system, /persist partitions
CONFIG_EXT4_FS=y

# Overlay FS — magic mount / overlay partitions
CONFIG_OVERLAY_FS=y

# Module support — enables loading vendor .ko files
CONFIG_MODULES=y

# ──────────────────────────────────────────
# Debug / crash logging
# ──────────────────────────────────────────

# GENI serial: full driver selects SERIAL_CORE (kbuild hard mechanism)
# — defconfig CONFIG_SERIAL_CORE=y is silently ignored by kbuild;
#   SERIAL_QCOM_GENI has 'select SERIAL_CORE' which forces it.
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_MSM_GENI_EARLY_CONSOLE=y

# PSTORE / ramoops — preserve kernel log across crash+reboot
# Needs DTS reserved-memory node ramoops@B0000000 (see sm8250-oneplus8t.dts)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# OPLUS logbuf — preserve printk to reserved-memory across warm reset
# Needs DTS reserved-memory node oplus,logbuf (see sm8250-oneplus8t.dts)
CONFIG_OPLUS_LOGBUF=y

# Printk enhancements
CONFIG_PRINTK_TIME=y
CONFIG_PRINTK_CALLER=y
CONFIG_DYNAMIC_DEBUG_CORE=y
CONFIG_IPC_LOGGING=y
CONFIG_FTRACE=y
