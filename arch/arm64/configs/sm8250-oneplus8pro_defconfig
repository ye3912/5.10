# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_LZ4=y
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 ignore_loglevel log_buf_len=1M androidboot.console=ttyMSM0 androidboot.hardware=qcom androidboot.memcg=1 lpm_levels.sleep_disabled=1 video=vfb:640x400,bpp=32,memsize=3072000 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=a800000.dwc3 swiotlb=2048 loop.max_part=7 cgroup.memory=nokmem,nosocket"
CONFIG_CMDLINE_EXTEND=y
CONFIG_ANDROID=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SM8250=y
CONFIG_LOCALVERSION="-lineageos"
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Kona (SM8250) SoC
CONFIG_ARCH_KONA=y

# DT overlay support for OnePlus 8 Pro
CONFIG_MACH_ONEPLUS8PRO=y

# OnePlus specific drivers
CONFIG_OPLUS=y
CONFIG_OPLUS_FEATURE=y
CONFIG_OPLUS_CHG=y
CONFIG_OPLUS_SYSTEM=y

# GCC - Global Clock Controller
CONFIG_SM_GCC_8250=y

# CAMCC - Camera Clock Controller
CONFIG_SM_CAMCC_8250=y

# DISPCC - Display Clock Controller
CONFIG_SM_DISPCC_8250=y

# GPUCC - GPU Clock Controller
CONFIG_SM_GPUCC_8250=y

# VIDEOCC - Video Clock Controller
CONFIG_SM_VIDEOCC_8250=y

# NPUCC - NPU Clock Controller
CONFIG_SM_NPUCC_8250=y

# Interconnect
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y

# RPMH
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y

# AOSS
CONFIG_QCOM_AOSS_QMP=y

# IOMMU / SMMU — REQUIRED for DMA peripherals on SM8250
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_IOMMU_UTIL=y

# Mailbox / IPCC — inter-processor communication
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y

# HWSPINLOCK — required by QCOM_SMEM
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y

# PDC — wake-up capable interrupt controller
CONFIG_QCOM_PDC=y

# GLINK / QMI — Qualcomm IPC between apps/modem/ADSP
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_QMI_HELPERS=y

# CPUFreq
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# GPU
CONFIG_DRM_MSM=y
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_QFPROM=y

# Power reset
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT=y
CONFIG_POWER_RESET_QCOM_REBOOT_REASON=y

# Essential features
CONFIG_QCOM_CPR=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y

# UFS
CONFIG_SCSI_UFS_QCOM=y

# USB
CONFIG_USB_DWC3_QCOM=y

# PMIC
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y

# Pinctrl
CONFIG_PINCTRL_SM8250=y

# Thermal
CONFIG_QCOM_TSENS=y
CONFIG_CPU_THERMAL=y

# Debug / power
CONFIG_DEBUG_FS=y

# Framebuffer console — show boot logs on screen
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

# SELinux — required by panic_logstore (sel_set_enforce API)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

CONFIG_PANIC_LOGSTORE=y
CONFIG_OPLUS_LOGBUF=y
CONFIG_OPLUS_SCREENLOG=y

# soc/oplus: project/device/boot identification
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y
CONFIG_OPLUS_PROJECT_INFO=y
CONFIG_OPLUS_DEVICE_INFO=y
CONFIG_OPLUS_BOOT_MODE=y

# power/oplus: charging core and active I2C gauge
CONFIG_OPLUS_CHG_CORE=y
CONFIG_OPLUS_GAUGE_IC_BQ27541=y
# CONFIG_OPLUS_CHARGER_IC_MP2650 is not set
# CONFIG_OPLUS_CHARGER_IC_DA9313 is not set

# power/oplus: minimal wired charging state machine
CONFIG_OPLUS_CHARGER=y

# power/supply: dependency closure for QCOM SMB5 and BQ27541 gauge
CONFIG_QCOM_POWER_SUPPLY=y
CONFIG_I2C=y
CONFIG_IIO=y

# power/supply/qcom: SMB5 charger driver (required by Kona adapter)
CONFIG_QPNP_SMB5=y

# power/supply/qcom: OPLUS Kona SMB5 adapter (smb5_chg_ops → oplus_chg_operations)
CONFIG_OPLUS_CHARGER_IC_KONA=y

# rtc: PMIC RTC — SMB5 hard-requires alarmtimer_get_rtcdev() != NULL
CONFIG_RTC_DRV_PM8XXX=y

CONFIG_FONT_8x16=y

# Debug info for vmlinux (needed for crash analysis / addr2line)
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_REDUCED=n
