config OPLUS_BUG_STABILITY
	bool "OPLUS GPU fault kevent notification"
	depends on OPLUS_FEATURE
	default n
	help
	  Send GPU page-fault kevents via mm_fb_kevent for
	  bug-stability tracking and automated reporting.

