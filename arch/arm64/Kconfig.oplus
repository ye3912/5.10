menu "OPLUS vendor features"
	depends on OPLUS

config OPLUS_SYSTEM_KERNEL_QCOM
	bool "OPLUS Qualcomm platform kernel support"
	default n
	help
	  Enable OPLUS kernel support for Qualcomm SoC platforms (SM8250 etc).
	  This gates the drivers/soc/oplus/ build and various QCOM-specific
	  codepaths in OPLUS vendor modules.

