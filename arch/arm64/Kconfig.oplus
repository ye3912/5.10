config LOCKING_PROTECT
	bool "OPLUS locking protect"
	default n
	help
	  Protect UX tasks during mutex/rwsem contention. When enabled,
	  UX tasks that are blocked on a lock inherit priority boosting
	  to reduce latency. Requires CONFIG_OPLUS_FEATURE_SCHED_ASSIST.

config MMAP_LOCK_OPT
	bool "OPLUS mmap lock optimization"
	default n
	help
	  Reduce sleep time in mmap_lock contention paths. Optimizes
	  the mmap_lock for UX tasks to minimize scheduling delays.

